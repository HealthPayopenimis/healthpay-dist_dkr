# Preserve the corrected V2 Nginx/entrypoint/TLS runtime. The new bundle is the
# complete artifact from HealthPay frontend CI at the source commit label.
# This is an immutable image build, never a running-container patch.
FROM registry.digitalocean.com/healthpay-payer/frontend@sha256:66413a309e7c0d2ad04cf58a5bf112a831fb7ef971144c7faf7fa17446b8362d
ARG FRONTEND_SOURCE_COMMIT
ARG FRONTEND_CI_RUN
ARG FRONTEND_ARTIFACT_SHA256
LABEL tech.healthpay.source.frontend=$FRONTEND_SOURCE_COMMIT
LABEL tech.healthpay.ci.frontend=$FRONTEND_CI_RUN
LABEL tech.healthpay.artifact.frontend=$FRONTEND_ARTIFACT_SHA256
RUN rm -rf /usr/share/nginx/html/*
COPY build/ /usr/share/nginx/html/
RUN find /usr/share/nginx/html -type d -exec chmod 755 {} \; \
    && find /usr/share/nginx/html -type f -exec chmod 644 {} \;
